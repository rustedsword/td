# These become tar --exclude patterns. A pattern without a slash matches ANY
# path component, and dpkg-source names members "<package>-<version>/..." so a
# leading ./ anchors nothing — only distinctive names are safe here.
#
# "build" must never appear: it would strip any nested build directory from the
# source tarball — in the tg_owt tree the same pattern silently removed
# src/build/build_config.h, and in tdesktop it broke the build outright.
#
# Top-level scratch directories are already stripped by inside-container.sh
# when it copies the tree, where ./-anchored excludes do work.
tar-ignore = .git
tar-ignore = .cache
tar-ignore = build-packages
tar-ignore = obj-*
